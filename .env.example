# Core
FLASK_SECRET_KEY=replace-with-a-long-random-value
LOOKOUT_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=postgresql+psycopg://lookout:lookout@db:5432/lookout
LOOKOUT_BASE_URL=http://localhost:8080

# Optional bootstrap owner. If blank, the first-run setup wizard is shown.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Worker controls
TELEGRAM_POLL_SECONDS=2
SCHEDULER_INTERVAL_SECONDS=30

# Branding
LOOKOUT_POWERED_BY=Goldszmidt

# Set to 1 behind HTTPS in production.
LOOKOUT_COOKIE_SECURE=0
